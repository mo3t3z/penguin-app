{
  "expo": {
    "name": "Penguin",
    "slug": "penguin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/penguin-app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.penguin.student",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/penguin-adaptive-foreground.png",
        "monochromeImage": "./assets/penguin-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/penguin-favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Penguin to access photos you choose to share.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "scheme": "penguin",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "011d2f5b-d2f2-4b1c-b1c1-1561c04c060c"
      }
    },
    "owner": "moetez3s-team"
  }
}
